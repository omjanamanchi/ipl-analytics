# Rendered to ./app.yaml by deploy/deploy_app.sh - edit this template, not app.yaml.
runtime: python312
instance_class: F1
entrypoint: gunicorn -b :$PORT --workers 2 --threads 4 --timeout 60 main:app

automatic_scaling:
  min_instances: 0          # scale to zero when idle (free tier covers F1 hours)
  max_instances: 2          # hard cap so a traffic spike cannot run up a bill

env_variables:
  INSTANCE_CONNECTION_NAME: "${PROJECT_ID}:${REGION}:${INSTANCE}"
  DB_NAME: "${DB_NAME}"
  DB_USER: "${APP_DB_USER}"
  DB_PASS_SECRET: "projects/${PROJECT_ID}/secrets/ipl-db-app-password/versions/latest"
  FLASK_SECRET_SECRET: "projects/${PROJECT_ID}/secrets/ipl-flask-secret-key/versions/latest"

handlers:
  - url: /static
    static_dir: app/static
    secure: always
  - url: /.*
    script: auto
    secure: always          # redirect http -> https
