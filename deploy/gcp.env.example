# Copy to deploy/gcp.env and fill in PROJECT_ID (and BILLING_ACCOUNT for the budget alert).
PROJECT_ID=ipl-analytics-cs348          # must be globally unique; lowercase, digits, hyphens
REGION=us-central1                      # Cloud SQL region
APP_ENGINE_REGION=us-central            # App Engine uses its own region names
INSTANCE=ipl-db
DB_NAME=ipl
APP_DB_USER=ipl_app
BILLING_ACCOUNT=                        # optional: XXXXXX-XXXXXX-XXXXXX for a $20 budget alert
